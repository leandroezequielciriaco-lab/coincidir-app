{
  "expo": {
    "name": "Coincidir",
    "slug": "coincidir-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/coincidir-logo-official.png",
    "scheme": "coincidirapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/coincidir-logo-official.png"
    },
    "android": {
      "package": "com.leandroezequielciriaco.coincidir",
      "adaptiveIcon": {
        "backgroundColor": "#FCFAF3",
        "foregroundImage": "./assets/images/coincidir-logo-official.png",
        "monochromeImage": "./assets/images/coincidir-logo-official.png"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/coincidir-logo-official.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/coincidir-logo-official.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FCFAF3",
          "android": {
            "image": "./assets/images/coincidir-logo-official.png",
            "imageWidth": 220,
            "backgroundColor": "#FCFAF3"
          },
          "ios": {
            "image": "./assets/images/coincidir-logo-official.png",
            "imageWidth": 220,
            "backgroundColor": "#FCFAF3"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "COINCIDIR usa tu ubicación para ayudarte a fijar el punto exacto de una actividad."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "COINCIDIR usa tus fotos para actualizar tu foto de perfil.",
          "cameraPermission": "COINCIDIR usa la cámara para tomar tu foto de perfil.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
